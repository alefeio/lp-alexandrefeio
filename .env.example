RESEND_API_KEY=
CONTACT_TO_EMAIL=alexandrefpenha@gmail.com
CONTACT_FROM_EMAIL=Alexandre Feio <contato@alexandrefeio.com.br>
CONTACT_REPLY_TO_EMAIL=alexandrefpenha@gmail.com
NEXT_PUBLIC_GTM_ID=

# Banco de desenvolvimento da plataforma. Não usar estes valores em production.
# Runtime da aplicação (pooled).
RUNTIME_DATABASE_URL=
# Conexão direta para migrations e CLI.
POSTGRES_URL=
# Mesma conexão direta, hoje. O código não usa esta variável.
DATABASE_URL=
# Fora de runtime e de migration.
PRISMA_DATABASE_URL=
# Rótulo do runtime, não do banco físico. development e production podem usar o mesmo Postgres.
DATABASE_ENV=

# Better Auth. Sem prefixo NEXT_PUBLIC_.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# Comércio. false por padrão. Production não deve ligar nesta fase.
COMMERCE_ENABLED=false
# true só no ambiente de production, junto com DATABASE_ENV=production, VERCEL_ENV=production e MERCADO_PAGO_ENV=production.
COMMERCE_PRODUCTION_READY=false
# test no development. production só no ambiente de production. Não copiar credencial entre os dois.
MERCADO_PAGO_ENV=
NEXT_PUBLIC_MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=

# Imagens editoriais públicas. Nunca usar prefixo NEXT_PUBLIC_.
# O serviço aceita até 10 MB. Este site envia no máximo 5 MB (JPEG, PNG, WebP).
# APIMG_API_KEY tem de ser igual à API_KEY do servidor Apimages. Não há cadastro à parte.
# APIMG_UPLOAD_URL é a URL completa, com /v1/upload. O site não acrescenta esse caminho.
APIMG_API_KEY=
APIMG_UPLOAD_URL=
