generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Conta da plataforma. `role` só aceita USER ou ADMIN na aplicação.
/// O cadastro não pode definir esse campo.
model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  role          String    @default("USER")
  createdAt     DateTime
  updatedAt     DateTime
  sessions             Session[]
  accounts             Account[]
  lessonProgress       LessonProgress[]
  lessonBlockProgress  LessonBlockProgress[]
  lessonResponses      LessonResponse[]
  lessonNotes          LessonNote[]
  lessonBookmarks      LessonBookmark[]
  lessonResults        LessonResult[]
  projects             Project[]
  diagnostics          Diagnostic[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@index([identifier])
  @@map("verification")
}

enum ContentStatus {
  DRAFT
  PUBLISHED
}

enum AccessType {
  FREE
  PAID
}

enum BlockType {
  TEXT
  HEADING
  CALLOUT
  EXAMPLE
  CHECKPOINT
  ACTIVITY
  CHECKLIST
  RESULT
  CONCLUSION
  IMAGE
}

model Course {
  id                 String        @id @default(cuid())
  slug               String        @unique
  title              String
  subtitle           String?
  description        String
  status             ContentStatus @default(DRAFT)
  sortOrder          Int           @default(0)
  bundlePriceCents   Int?
  coverImageUrl      String?
  coverImagePublicId String?
  publishedAt        DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  modules            Module[]

  @@map("course")
}

model Module {
  id               String        @id @default(cuid())
  courseId         String
  course           Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  slug             String
  title            String
  description      String
  status           ContentStatus @default(DRAFT)
  sortOrder        Int           @default(0)
  bundlePriceCents Int?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  lessons          Lesson[]

  @@unique([courseId, slug])
  @@index([courseId])
  @@map("module")
}

model Lesson {
  id                String        @id @default(cuid())
  moduleId          String
  module            Module        @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  slug              String        @unique
  title             String
  summary           String
  publicPreview     String?
  estimatedMinutes  Int?
  sortOrder         Int           @default(0)
  status            ContentStatus @default(DRAFT)
  accessType        AccessType
  priceCents        Int?
  publishedAt       DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  blocks            LessonBlock[]
  progress          LessonProgress[]
  blockProgress     LessonBlockProgress[]
  responses         LessonResponse[]
  notes             LessonNote[]
  bookmarks         LessonBookmark[]
  results           LessonResult[]
  recommendations   Recommendation[]

  @@index([moduleId])
  @@index([status])
  @@map("lesson")
}

/// Bloco tipado. `blockKey` é estável e não segue posição nem texto.
model LessonBlock {
  id                 String    @id @default(cuid())
  lessonId           String
  lesson             Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  blockKey           String
  type               BlockType
  position           Int
  payload            Json
  countsForProgress  Boolean   @default(true)
  required           Boolean   @default(false)
  retiredAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([lessonId, blockKey])
  @@index([lessonId, position])
  @@map("lesson_block")
}

model LessonProgress {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId     String
  lesson       Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  startedAt    DateTime  @default(now())
  lastActiveAt DateTime  @default(now())
  lastBlockKey String?
  percent      Int       @default(0)
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([userId, lessonId])
  @@index([userId])
  @@map("lesson_progress")
}

model LessonBlockProgress {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId    String
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  blockKey    String
  viewedAt    DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, lessonId, blockKey])
  @@index([userId, lessonId])
  @@map("lesson_block_progress")
}

model LessonResponse {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  blockKey  String
  payload   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, lessonId, blockKey])
  @@index([userId, lessonId])
  @@map("lesson_response")
}

model LessonNote {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  blockKey  String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, lessonId, blockKey])
  @@index([userId])
  @@map("lesson_note")
}

model LessonBookmark {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  blockKey  String
  createdAt DateTime @default(now())

  @@unique([userId, lessonId, blockKey])
  @@index([userId])
  @@map("lesson_bookmark")
}

/// Resultado prático da aula. Sem `projectId`, é o resultado pessoal daquela aula.
/// Com `projectId`, a mesma aula pode ter um resultado por negócio.
/// A unicidade parcial fica na migration: um pessoal e um por projeto.
model LessonResult {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  payload   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, lessonId])
  @@index([projectId])
  @@map("lesson_result")
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

enum ProjectObjective {
  LEADS
  SALES
  WHATSAPP
  STORE_VISITS
  AWARENESS
  UNDEFINED
}

enum DestinationType {
  LANDING_PAGE
  WEBSITE
  WHATSAPP
  INSTAGRAM
  MARKETPLACE
  OTHER
  UNDEFINED
}

enum DiagnosticStatus {
  IN_PROGRESS
  COMPLETED
}

enum RecommendationType {
  LEARN
  EXECUTE
  ANALYZE
  WAIT
}

enum RecommendationPriority {
  HIGH
  MEDIUM
  LOW
}

model Project {
  id                      String            @id @default(cuid())
  userId                  String
  user                    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                    String
  segment                 String?
  primaryOffer            String?
  objective               ProjectObjective?
  usesGoogleAds           Boolean?
  usesMetaAds             Boolean?
  destinationType         DestinationType?
  monthlyMediaBudgetCents Int?
  averageTicketCents      Int?
  websiteUrl              String?
  serviceArea             String?
  status                  ProjectStatus     @default(ACTIVE)
  archivedAt              DateTime?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  diagnostics             Diagnostic[]
  recommendations         Recommendation[]
  lessonResults           LessonResult[]

  @@index([userId, updatedAt])
  @@map("project")
}

model Diagnostic {
  id                String            @id @default(cuid())
  projectId         String
  project           Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId            String
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  version           String
  status            DiagnosticStatus  @default(IN_PROGRESS)
  answers           Json
  dimensionScores   Json?
  overallScore      Int?
  primaryBottleneck String?
  resultSnapshot    Json?
  currentStep       Int               @default(0)
  startedAt         DateTime          @default(now())
  completedAt       DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  recommendations   Recommendation[]

  @@index([projectId, createdAt])
  @@index([userId])
  @@map("diagnostic")
}

model Recommendation {
  id           String                 @id @default(cuid())
  projectId    String
  project      Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  diagnosticId String?
  diagnostic   Diagnostic?            @relation(fields: [diagnosticId], references: [id], onDelete: Cascade)
  type         RecommendationType
  priority     RecommendationPriority
  title        String
  description  String
  rationale    String?
  lessonId     String?
  lesson       Lesson?                @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  createdAt    DateTime               @default(now())

  @@index([projectId, createdAt])
  @@index([diagnosticId])
  @@map("recommendation")
}
